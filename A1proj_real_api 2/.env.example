# 复制为 .env 并填写真实 Key（支持智谱 / 通义 DashScope 等 OpenAI 兼容接口）
ZHIPU_API_KEY=your_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

LLM_PROVIDER=glm
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=120
LLM_ALLOW_FALLBACK=false

# 真实向量嵌入模型（通义示例：text-embedding-v3；智谱示例：embedding-2）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 视觉故障识别（通义示例：qwen-vl-plus；智谱示例：glm-4v-flash）
VISION_MODEL=qwen-vl-plus

# 手册目录（默认项目根 data/）
DATA_DIR=

# 管理员审核 Token
ADMIN_TOKEN=admin-change-me
